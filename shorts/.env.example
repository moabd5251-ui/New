# Copy to .env and fill in. Every key is optional — the pipeline degrades
# gracefully and still renders a video without any of them.

# --- Stock footage (free keys) ---
# https://www.pexels.com/api/        — best quality, portrait filter
PEXELS_API_KEY=
# https://pixabay.com/api/docs/      — good fallback, wider catalogue
PIXABAY_API_KEY=

# --- Voiceover (pick one) ---
# https://elevenlabs.io — "Adam" is the default faceless-Shorts voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2

# https://platform.openai.com — cheaper, fewer voices
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Local neural TTS, free, no account. Point at a downloaded .onnx voice.
# https://github.com/rhasspy/piper
PIPER_MODEL=

# --- YouTube upload ---
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
# -> OAuth client ID -> Application type: "Desktop app".
# Enable "YouTube Data API v3" for the project first.
#
# Read the Verification section of the README before uploading: videos sent
# through an unaudited API project are locked to private permanently.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Captions ---
# Any font installed on the system. Bold grotesques read best.
CAPTION_FONT=Liberation Sans
