# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Revenue — all optional. Anything left unset simply earns nothing; the app
# still runs and links still work. Set these on the SERVER (Railway), never in
# the frontend build, so affiliate IDs stay out of the browser bundle.
# See MONETIZATION.md for which programs to apply to and in what order.
# ---------------------------------------------------------------------------

# Owner-only revenue dashboard at /?admin=1 — required to view it.
# Use a long random string: `openssl rand -hex 32`
ADMIN_TOKEN=

# Affiliate network IDs
AFF_IMPACT_ID=
AFF_RAKUTEN_ID=
AFF_CJ_ID=
AFF_AWIN_ID=
AFF_AMAZON_TAG=

# Flat-fee partner referral links (paste the link each program gives you)
AFF_IBOTTA_URL=
AFF_RAKUTEN_REFERRAL_URL=
AFF_FETCH_URL=
AFF_INSTACART_URL=
AFF_HELLOFRESH_URL=
AFF_THRIVE_URL=

# Per-signup payouts, used only to rank offers on the dashboard.
# Override once your real numbers come in.
AFF_CPA_IBOTTA=5
AFF_CPA_RAKUTEN=25
AFF_CPA_FETCH=3
AFF_CPA_INSTACART=12
AFF_CPA_HELLOFRESH=18
AFF_CPA_THRIVE=30

# Estimation inputs for the dashboard's projected-revenue figure
REV_ASSUMED_BASKET=85
REV_ASSUMED_CVR=0.03

# Shared secret for affiliate conversion postbacks
AFFILIATE_WEBHOOK_SECRET=

# Stripe — Pro subscription billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PRO_PRICE_USD=3.99
PUBLIC_SITE_URL=http://localhost:5173
