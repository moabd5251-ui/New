# Copy to .env and fill in. Every key is optional — the pipeline degrades
# gracefully and still renders a video without any of them.

# --- Stock footage (free keys) ---
# https://www.pexels.com/api/        — best quality, portrait filter
PEXELS_API_KEY=
# https://pixabay.com/api/docs/      — good fallback, wider catalogue
PIXABAY_API_KEY=

# --- Voiceover (pick one) ---
# https://elevenlabs.io — "Adam" is the default faceless-Shorts voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2

# https://platform.openai.com — cheaper, fewer voices
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Local neural TTS, free, no account. Point at a downloaded .onnx voice.
# https://github.com/rhasspy/piper
PIPER_MODEL=

# --- YouTube upload ---
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
# -> OAuth client ID -> Application type: "Desktop app".
# Enable "YouTube Data API v3" for the project first.
#
# Read the Verification section of the README before uploading: videos sent
# through an unaudited API project are locked to private permanently.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Scheduling ---
# Local times of day to post at, and the cap per day.
SCHEDULE_SLOTS=09:00,18:00
SCHEDULE_MAX_PER_DAY=2

# publish-at: upload early, YouTube flips it public at the slot (nothing needs
#             to be running at post time)
# drip:       hold the upload until the slot arrives, then post it
SCHEDULE_MODE=publish-at

# drip mode only. publish-at always ends up public.
SCHEDULE_PRIVACY=private

SCHEDULE_CATEGORY=education
# Raise only if Google granted your project more than the default 10,000/day.
SCHEDULE_QUOTA_BUDGET=10000

# Standing consent for a cron job, instead of passing --yes on every run.
# Only set this once you have watched a few runs do the right thing.
SCHEDULE_YES=false

# --- Captions ---
# Any font installed on the system. Bold grotesques read best.
CAPTION_FONT=Liberation Sans
